<!DOCTYPE html>
<html>
<head>
    <title>Log into Instagram - Tugas 3 HTML</title>

    <style>
        body {
            margin: 0;
            background-color: #121212;
            color: white;
            font-family: Arial, sans-serif;
        }

        input {
            width: 100%;
            height: 60px;
            box-sizing: border-box;
            background-color: #121212;
            border: 1px solid #555;
            border-radius: 14px;
            padding: 15px;
            color: white;
            font-size: 14px;
        }

        input::placeholder {
            color: #999;
        }

        .login {
            background-color: #0064e0;
            border-radius: 25px;
            padding: 13px;
        }

        .facebook {
            background-color: #262626;
            border-radius: 25px;
            padding: 13px;
        }

        .create {
            border: 1px solid #0095f6;
            border-radius: 25px;
            padding: 12px;
        }

        a {
            text-decoration: none;
        }
    </style>
</head>

<body>

    <table width="100%" height="100%" border="0" cellpadding="20" cellspacing="0">
        <tr valign="middle">

            <!-- Kolom Kiri: Branding -->
            <td width="50%" align="center">

                <table border="0" cellpadding="10" cellspacing="0" width="80%">

                    <tr>
                        <td align="center">
                            <img src="https://static.cdninstagram.com/rsrc.php/yO/r/Ny6hrBVLYjl.webp"
                            alt="Instagram Logo" width="80">
                        </td>
                    </tr>

                    <tr>
                        <td align="center">
                            <h1>
                                See everyday moments from your
                                <font color="#e1306c">close friends</font>.
                            </h1>
                        </td>
                    </tr>

                    <tr>
                        <td align="center">
                            <img src="https://static.cdninstagram.com/rsrc.php/yJ/r/53X3pk-t2Gn.webp"
                            alt="Close Friends Showcase" width="300">
                        </td>
                    </tr>

                </table>

            </>


            <!-- Pembatas Tengah -->
            <td width="1" bgcolor="#262626"></td>


            <!-- Kolom Kanan: Form Login -->
            <td width="50%" align="center">

                <table border="0" cellpadding="8" cellspacing="0" width="400">

                    <tr>
                        <td align="left">
                            <h2>Log into Instagram</h2>
                        </td>
                    </tr>

                    <tr>
                        <td>

                            <form action="#" method="post">

                                <table border="0" cellpadding="8" cellspacing="0" width="100%">

                                    <!-- Username -->
                                    <tr>
                                        <td>
                                            <input type="text"
                                            name="username"
                                            placeholder="Mobile number, username or email">
                                        </td>
                                    </tr>

                                    <!-- Password -->
                                    <tr>
                                        <td>
                                            <input type="password"
                                            name="password"
                                            placeholder="Password">
                                        </td>
                                    </tr>


                                    <!-- Tombol Log In -->
                                    <tr>
                                        <td align="center" class="login">

                                            <a href="#">
                                                <font color="#ffffff" size="3">
                                                    <b>Log in</b>
                                                </font>
                                            </a>

                                        </td>
                                    </tr>


                                    <!-- Forgot Password -->
                                    <tr>
                                        <td align="center">

                                            <a href="#">
                                                <font color="#ffffff" size="2">
                                                    <b>Forgot password?</b>
                                                </font>
                                            </a>

                                        </td>
                                    </tr>


                                    <!-- Facebook -->
                                    <tr>
                                        <td align="center" class="facebook">

                                            <a href="#">
                                                <font color="#ffffff" size="3">
                                                    <b>● &nbsp;Log in with Facebook</b>
                                                </font>
                                            </a>

                                        </td>
                                    </tr>


                                    <!-- Create New Account -->
                                    <tr>
                                        <td align="center">

                                            <table border="0"
                                            cellpadding="0"
                                            cellspacing="0"
                                            width="100%">

                                                <tr>
                                                    <td align="center" class="create">

                                                        <a href="#">
                                                            <font color="#0095f6" size="3">
                                                                <b>Create new account</b>
                                                            </font>
                                                        </a>

                                                    </td>
                                                </tr>

                                            </table>

                                        </td>
                                    </tr>


                                    <!-- Meta -->
                                    <tr>
                                        <td align="center">

                                            <br>

                                            <font color="#8e8e8e" size="2">
                                                <b>&infin; Meta</b>
                                            </font>

                                        </td>
                                    </tr>

                                </table>

                            </form>

                        </td>
                    </tr>

                </table>

            </td>

        </tr>
    </table>

</body>
</html>
